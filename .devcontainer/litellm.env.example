OPENAI_API_KEY=your-openai-api-key
LITELLM_MASTER_KEY=sk-your-local-litellm-master-key
LITELLM_SALT_KEY=change-me-before-adding-models
UI_USERNAME=your-admin-username
UI_PASSWORD=your-admin-password

# Reduce the local spend-log flush window so Responses API
# `previous_response_id` rehydration is less likely to race LiteLLM logging.
PROXY_BATCH_WRITE_AT=1
SPEND_LOG_QUEUE_POLL_INTERVAL=0.25
SPEND_LOG_QUEUE_SIZE_THRESHOLD=1

# LiteLLM cold storage is backed by Cloudflare R2.
# R2 credentials and bucket settings live in `.devcontainer/cf-r2.env`.

# Optional OpenAI-compatible override for the LiteLLM upstream provider.
# Leave unset for the normal OpenAI API path.
# OPENAI_BASE_URL=https://your-openai-compatible-provider.example/v1
